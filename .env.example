# SpendWise Environment Variables Template
# Copy this file to .env or .env.local

# Note for Vercel: When pasting into Vercel's Environment Variables UI, do NOT include surrounding quotes.

# Database (PostgreSQL via Supabase Transaction Pooler - Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Direct Database URL for Prisma Migrations (Session mode - Port 5432)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth & Storage Configuration
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# AI Coach API Keys (Google Gemini or OpenAI - Server-side only)
GEMINI_API_KEY=AQ.Ab8RN6...
OPENAI_API_KEY=sk-proj-...

# Next.js App URL
NEXT_PUBLIC_APP_URL=https://pocketmate-psi.vercel.app
